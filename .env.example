# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema files in "/src/lib/env"
# directory should be updated accordingly.

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Disable Prisma telemetry
CHECKPOINT_DISABLE=1

# Example connection string for SQLite:
DATABASE_URL=file:./prisma/dev.db

# Better Auth Secret, generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret

# Better Auth Base URL, localhost for dev, real domain in production env
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Allowed Origins, comma separated, mirrors trustedOrigins
BETTER_AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Disable Better Auth telemetry
BETTER_AUTH_TELEMETRY=0

# Google OAuth, get from Google Cloud Console, callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth, get from Discord Developer Portal, callback: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Seed logins, used by prisma/seed.ts and playwright-cli verification
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Admin
BUYER_EMAIL=buyer@example.com
BUYER_PASSWORD=Buyer12345
BUYER_NAME=Buyer
SELLER_EMAIL=seller@example.com
SELLER_PASSWORD=Seller12345
SELLER_NAME=Seller
